#!/usr/bin/env bash
# Format gate: `stylua --check` on the Lua files staged for this commit.
#
# Enabled with `git config core.hooksPath .githooks` (one-time, per clone).
# The repo predates this gate and half its Lua files do not match
# .stylua.toml, so it ratchets: only the files in the commit are checked, not
# the whole tree. Run `stylua <files>` to fix, then re-stage.
#
# Checks the working-tree file, not the staged blob: a partially staged file
# (`git add -p`) is judged by its full content.

set -u

[ "${SKIP_STYLUA:-}" = "1" ] && exit 0

if ! command -v stylua >/dev/null 2>&1; then
  echo "pre-commit: stylua not found; skipping format check" >&2
  exit 0
fi

list=$(mktemp)
trap 'rm -f "$list"' EXIT
git diff --cached --name-only --diff-filter=ACM -z -- '*.lua' >"$list"

[ -s "$list" ] || exit 0

fail=0
while IFS= read -r -d '' f; do
  if ! stylua --check -- "$f" >/dev/null 2>&1; then
    echo "pre-commit: not stylua-formatted: $f" >&2
    fail=1
  fi
done <"$list"

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: run 'stylua <files>' and re-stage (SKIP_STYLUA=1 to bypass)" >&2
fi
exit "$fail"
